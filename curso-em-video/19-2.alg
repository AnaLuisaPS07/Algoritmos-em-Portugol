// Prática estruturas de repetição 02: enquanto
//Contando de forma decrescente

algoritmo "ContarDE10a0"

var

   contador: inteiro


inicio

      contador <- 11
      
      Enquanto (contador >= 0) faca
      
        contador <- contador - 1
        Escreval (contador)
        
      FimEnquanto
      
      EScreval ("Terminei de contar")

fimalgoritmo

//Nesse caso já começa com um número grande e vai decrementando
//no console tambem aparece "-1", não sei porquê
