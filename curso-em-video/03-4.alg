algoritmo "operadores_rlacionais"

var
  A, B, C: inteiro

inicio

  A <- 5
  B <- 4
  C <- 3
  
  Escreval ((A>B) e (C<B))
  
  Escreval ((A=B) e (C<B))
  
  Escreval ((A<>B) e (C<B))
  
  
  Escreval ((A>B) ou (C<B))
  
  Escreval ((A=B) ou (C<B))

  Escreval ((A<>B) ou (C<B))
  
  Escreval( nao(A<>B) ou (C<B))
  //não funcionou como deveria
  

  
fimalgoritmo
