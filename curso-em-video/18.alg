algoritmo "JogodeFutebol"

var

   pal, sao, d: inteiro

inicio

      Escreval("--------------------------")
      Escreval("  Palmeiras x Sao Paulo   ")
      Escreval("--------------------------")

      Escreval ("quantos gols fez o Palmeiras?")
      Leia (pal)
      
      Escreval ("Quantos gols fez o São Paulo?")
      Leia (sao)
      
      d <- (pal - sao)
      
      Escreval ("A diferençaa de gols é ", d)
      
      Escolha (d)
       caso 1,2, 3
          Escreval ("Normal hein")
          
       caso 4,5,6,7,8,9,10
          Escreval ("Goleada hein")
          
       caso 0
          Escreval ("Empate")

   FimEscolha
fimalgoritmo

