algoritmo "creuza01"

var

   ano_now, ano_past, age: inteiro
   
inicio

       Escreva ("Em que ano estamos?")
       leia (ano_now)
       Escreva ("Em que ano eu nasci?")
       leia (ano_past)
       
       age<- ano_now-ano_past
       
       Escreval ("Minha idade é:" , age)
       
         Se (age>=18) entao
        
           Escreva ("e eu já posso ser presa")
        
         FimSe
        
fimalgoritmo
