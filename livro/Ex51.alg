//Utilizando estrutura de repetição PARA
//Exibindo a tabuada de 3
algoritmo "Ex51"

var
   contador: inteiro

inicio
      Escreval ("-------------------------")
      Escreval ("Inicio do Programa")
      Escreval ("-------------------------")
      
       Para contador de 1 ate 10 faca
          Escreval ("3 x ", contador , " = " , Contador * 3)
      FimPara

fimalgoritmo