//Utilizando estrutura de repetição PARA
algoritmo "Ex49"

var
   contador: inteiro

inicio
      Escreval ("-------------------------")
      Escreval ("Inicio do Programa")
      Escreval ("-------------------------")
      
      Para contador de 1 ate 5 faca
          Escreval ("Bom dia")
      FimPara

fimalgoritmo