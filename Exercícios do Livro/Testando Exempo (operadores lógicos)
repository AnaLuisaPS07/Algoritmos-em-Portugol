algoritmo "aptoDirigir"

var

  idade: inteiro
  horasT, horasP: real
  

inicio

 Escreval ("Digite a idade do candidato: ")
 Leia(idade)
 
 Escreval ("Digite a quantidade de aulas teóricas assistidas: ")
 Leia (horasT)
 
 Escreval ("Digite a quantidade de aulas práticas assistidas:")
 Leia (horasP)
 
 
  se (idade>= 18) e (horasT >= 45) e (horasP >= 20)entao
    Escreval ("Apto")
  senao
    Escreval ("não apto")
 fimse
 
 

fimalgoritmo
