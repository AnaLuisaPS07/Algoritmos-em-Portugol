algoritmo "E29"

var

   N: inteiro

inicio

      Escreval ("Digite um número entre 1 e 12 para descobrir o mês do ano correspondente: ")
      Leia (N)
      
       Escolha (N)
        Caso 1
          Escreva ("Mês: Janeiro")
          
        Caso 2
          Escreva ("Mês: Fevereiro")
          
         Caso 3
          Escreva ("Mês: Março")
          
         Caso 4
          Escreva ("Mês: Abril")
          
         Caso 5
          Escreva ("Mês: Maio")

         Caso 6
          Escreva ("Mês: Junho")
          
         Caso 7
          Escreva ("Mês: Julho")

         Caso 8
          Escreva ("Mês: Agosto")
          
         Caso 9
          Escreva ("Mês: Setembro")
          
         Caso 10
          Escreva ("Mês: Outubro")
          
         Caso 11
          Escreva ("Mês: Novembro")
          
         Caso 12
          Escreva ("Mês: Dezembro")
          
         OutroCaso
          Escreva ("Número inválido, escolha um de 1 a 12")
          
       FimEScolha

fimalgoritmo
