Utilizando estrutura de repetição PARA

algoritmo "E35"

var

   nota, maiorNota, menorNota, mediaNotas, total: real
   contador: inteiro

inicio

      maiorNota <- 0
      menorNota <- 0
      total <- 0

       Para contador de 1 ate 5 faca
          Escreval ("---------------------------------")
          Escreval ("TURMA DE LÓGICA DE PROGRAMAÇÃO")
          Escreval ("---------------------------------")

          Escreval ("Informe a nota do aluno: ")
          Leia (nota)

          Escreval (" ")

          Se (contador = 1) entao
              maiorNota <- nota

            Senao
             Se (maiorNota < nota) entao
               maiorNota <- nota
               
               Senao
                se(nota < maiorNota) entao
                  nota <- menorNota
                
             fimse
             FimSe
            FimSe

           total <- (total + nota)

       FimPara

          Escreval ("RELATÓRIO DA TURMA")
          
          Escreval ("Maior nota: ", maiorNota)
          Escreval ("Menor nota: ", menorNota)
          EScreval ("Média das notas: ", total/25)

fimalgoritmo
