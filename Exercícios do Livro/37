//Utilizando estrutura de repetição ENQUANTO

algoritmo "E37"

var

   numero, soma, contador: inteiro

inicio

  soma <- 0
  contador <- 0

  Enquanto (contador < 5 ) faca
   Escreval ("Digite um número: ")
   Leia (numero)

   Escreval (" ")

   soma <- soma + numero
   contador <- contador + 1

  FimEnquanto

  Escreval ("Total somado: ", soma)

fimalgoritmo
