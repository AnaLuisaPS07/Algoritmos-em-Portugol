//EXERCICIO 27 NÃO TERMINADO


algoritmo "E27"


var

   compras: caractere
   dezPaes, queijo, bisnaga, paoForma, leite, paoDoce, suspiro: real
   compra1, compra2, compra21, compra3, compra31: real
inicio

    dezPaes <- 12
    queijo <- 20
    bisnaga <- 2
    paoForma <- 15
    leite <- 9
    paoDoce <- 17
    suspiro <- 7

    compra1 <- dezpaes + queijo
    //10 paes e um queijo   10 %
    
    compra2 <- bisnaga
    //uma bisnaga OU um pão de forma 15%
    
    compra21 <- paoForma
    
    compra3 <- leite + paoDoce
    //leite e pão doce OU suspiro 5%
    
    compra31 <- suspiro
    
    c
    
    Escreval ("-----------------------------------")
    Escreval ("TABELA DE VALORES: ")
    Escreval ("-----------------------------------")
    Escreval ("10 Pães: R$12")
    Escreval ("Queijo: R$20")
    Escreval ("Bisnaga: R$2")
    Escreval ("Pão de Forma: R$15")
    Escreval ("Leite: R$9")
    Escreval ("Pão doce: R$17")
    Escreval ("Suspiro: R$7")
    
    Escreval ("-----------------------------------")
    Escreval ("Digite o que você vai comprar: ")
    //Leia (compras)
    Escreval ("-----------------------------------")
    
    Leia (compras)
    
    
    
    Se (compras = "10 pães e um queijo") entao
       Escreval ("Você receberá um cupom de 10% de desconto na sua compra!")
       EScreval ("O valor original seria ", compra1 , " com o cupom aplicado fica R$ TESTE")
    Fimse

fimalgoritmo
