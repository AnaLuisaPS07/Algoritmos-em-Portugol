//Utilizando estrutura de repetição PARA

algoritmo "E32"

var

   numero, soma, contador: inteiro
   
inicio

  soma <- 0 // VARIÁVEL TOTALIZADORA, a princípio precisa ser inicializada com zero pra poder ir somando os valores

  Para contador de 1 ate 5 faca
   Escreval ("Digite um número")
   Leia (numero)
          
   Escreval (" ")
          
   soma <- soma + numero
           
  FimPara

   Escreval ("Total somado: ", soma)
           
fimalgoritmo
