algoritmo "E30"

var

   letra: caractere

inicio

      Escreval ("Digite uma letra para descobrir se ela faz parte do grupo das vogais: ")
      Leia (letra)
      
       Escolha (letra)
        Caso "A"
          Escreva ("É uma vogal!")
          
        Caso "E"
          Escreva ("É uma vogal!")
          
         Caso "I"
          Escreva ("É uma vogal!")
          
         Caso "0"
          Escreva ("É uma vogal!")
          
         Caso "U"
          Escreva ("É uma vogal!")
          
         OutroCaso
          Escreva ("Essa letra não é uma vogal")
          
       FimEScolha

fimalgoritmo
