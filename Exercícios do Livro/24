algoritmo "E25"

var

   vogal: caractere

inicio

      Escreva ("Digite uma Vogal: ")
      Leia (vogal)


      Se (vogal= "A")entao
      Escreva ("Palavras que começam com essa vogal: Ana, Amora, Avião")
      
       Senao
        Se (vogal = "E") entao
         Escreva ("Palavras que começam com essa vogal: Eliene, Elefante, Elétrico")
         
         Senao
          Se (vogal = "I") entao
           Escreva ("Palavras que começam com essa vogal: Igor, Índio, Isopor")
         
          Senao
           Se (vogal = "O") entao
            Escreva ("Palavras que começam com essa vogal: Osvaldo, Óculos, Onitorrinco")
         
           Senao
            Se (vogal = "U") entao
             Escreva ("Palavras que começam com essa vogal: Úrsula, Uva, U")
             
             Senao
               Escreva ("Resposta inválida")
               
          FimSe
         FimSe
        FimSe
       FimSe
      FimSe
         
fimalgoritmo
