algoritmo "imc25"

var

   KG, A, IMC: Real

inicio

      Escreva("Massa (Kg): ")
      Leia(KG)
      
      Escreva("Altura (m): ")
      Leia(A)
      
      IMC <- KG/(A * A)
      
      EscrevaL("IMC: ", IMC)


      se (IMC<18.5)entao
        Escreval ("Magreza")
      Senao
       Se (IMC>=18.5) e (IMC<=24.9) entao
         Escreval ("Normal")
       Senao
        Se (IMC>24.9) e (IMC<30) entao
         Escreval ("Sobrepeso")
       Senao
        Se (IMC>=30) entao
         Escreval ("Obesidade")
       Fimse
      Fimse
     Fimse
    Fimse
    
fimalgoritmo

