algoritmo "E15"


var

   nome: caractere
   n1, n2, media: real

inicio

      Escreval ("Digite o nome completo do aluno: ")
      Leia (nome)
      
      Escreval ("Digite a nota 1 do aluno: ")
      Leia (n1)
      
      Escreval ("Digite a nota 2 do aluno: ")
      Leia (n2)
      
      media <- (n1 + n2)/2
      
      Escreval ("A média do aluno é ", media)

      Se (media >= 6) entao
         Escreval ("APROVADO!")
          Senao
            Escreval ("REPROVADO!")
      Fimse

fimalgoritmo
