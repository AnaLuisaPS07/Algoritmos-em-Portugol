algoritmo "E18"

var

   resposta: caractere
   
inicio

      Escreval ("Você presiva de atendimento prioritário?")
      Leia (resposta)
      
        Se (resposta = "sim") entao
           Escreval ("Vá para os caixas 1,2 ou 3")
           
            Senao
             Escreval("Se dirija a qulaquer caixa, menos os 1, 2 e 3, que são prioritários")
          
        Fimse
fimalgoritm
