algoritmo "E11"

var

  nome, frase: caractere

inicio

  Escreval ("Olá, como se chama? ")
  Leia (nome)
  
  Escreval ("Conta para mim," , nome, ",qual é a sua frase preferida?")
  Leia (frase)
  
  Escreval ("Então a frase preferida da(o) ", nome, " é ", frase, ". Interessante!")
  
fimalgoritmo
