algoritmo "E12"

var

  musica: caractere
  duracao: real
  anoLancada: inteiro
  spotify: logico
  
inicio

   musica <- "Poloto automático"
   duracao <- 3
   anoLancada <- 2017
   spotify <- verdadeiro
   
   Escreval ("A minha música preferida é: ", musica)
   
   Escreval ("Ela tem ", duracao, " minutos de duração")
   
   Escreval ("Foi lançada no ano de: ", anoLancada)
   
   Escreval ("E é" , spotify, " que ela está no spotify ")

fimalgoritmo

