//30 vacinações em recém nascidos, faz a média entre os dias de vida de todos os bebês

algoritmo "Ex55"


var

   totalDias, diasNasc, c: inteiro


inicio

      totalDias <- 0
      c <- 0
      
      Enquanto (c <= 30) faca
        Escreval ("Digite a quantidade de dias de vida que tem o recém-nascido: ")
        Leia (diasNasc)
        
        totalDias <- totalDias + diasNasc
        c <- c + 1
        
      FimEnquanto
      
      
      Escreval ("A média dos bebês vacinados no dia foi de:  ", (totalDias/30), " dias")
fimalgoritmo
