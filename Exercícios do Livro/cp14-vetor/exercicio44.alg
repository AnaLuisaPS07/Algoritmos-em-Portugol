//Exercicio 44 - fidelizacao de clientes
//meio ble
Algoritmo "fidelizacao_clientes"

Var
   i:inteiro
   fidelizacao: vetor [0..9] de real

Inicio
   para i de 0 ate 9 faca
     escreva("Informe o valor do pagamento: ")
     leia(fidelizacao[i])
   fimpara
   
     escreval
     escreva("Hoje o seu almoço é uma cortesia da casa! Parabéns!")

Fimalgoritmo