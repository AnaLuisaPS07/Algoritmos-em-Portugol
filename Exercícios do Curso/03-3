algoritmo "operadores_relacionais"

var
  A, B, C: inteiro

inicio

  A <- 5
  B <- 4
  C <- 3
  
  Escreval (A>B)
  
  Escreval (A<B)
  
  Escreval (A=B)
  
  Escreval (A>=B)
  
  Escreval (A<=B)
  
  Escreval (A<>B)
  
  Escreval (A>7)
  
  Escreval (C = B -1)
  
  Escreval (A = C%B)
  
fimalgoritmo
