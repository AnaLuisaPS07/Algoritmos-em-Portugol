algoritmo "ContadorDeNegativcos"
var

   c, n, totN: inteiro
   
inicio

      c <- 1
      totN <- 0
      
      Repita
        EScreval ("Digite um número: ")
        Leia (n)
        
        c <- c +1
        
        Se (n < 0) entao
          totN <- totN + 1
        Fimse
        
      Ate (c > 5)
      
      Escreval ("Foram digitados" , totN, " valores negativos" )
      
fimalgoritmo
