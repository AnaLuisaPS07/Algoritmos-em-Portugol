//A sequência de Fibonacci é uma sequência numérica infinita em que cada termo 
//a partir do terceiro é a soma dos dois termos anteriores.

algoritmo "Sequência de Fibonnaci"

var

      c, n1, n2, n3: inteiro

inicio


   n1 <- 0
   Escreva (n1)
   
   n2 <- 1
   Escreva (n2)
   
Para c <- 3 ate 15 faca   // começa no 3 pq os dois primeiros já foram imprimidos
    
   n3 <- n1 + n2   // na primeira iterção o N3 será 1
   Escreva (n3)
        
    n1 <- n2 //atualiza N1 com o valor de N2. Isso faz com que o próximo cálculo de Fibonacci use o número anterior.
    n2 <- n3 //Atualiza N2 com o valor de N3. Isso faz com que o próximo cálculo de Fibonacci use o último número calculado

FimPara

fimalgoritmo
