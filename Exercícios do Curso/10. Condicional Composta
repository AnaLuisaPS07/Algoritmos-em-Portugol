algoritmo "CondicionalComposta"

var

    n: inteiro

inicio

      Escreva ("Digite qualquer número: ")
      Leia (n)

      Se (n % 2 = 0) entao // n resto da divisão por 2 igual a 0
       Escreva ("O número ", n, " é par")
      Senao
       Escreva ("O número ", n, " é impar")
      FimSe
      
fimalgoritmo
