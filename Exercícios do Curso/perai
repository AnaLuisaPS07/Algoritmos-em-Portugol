algoritmo "SuperContador"

var

    c, n : inteiro

inicio

    c <-1
    EscrevaL ("----------------- ")
    EscrevaL ("]     MENU       ]")
    EscrevaL ("----------------- ")
    EscrevaL ("] (1) De 1 a 10   ] ")
    EscrevaL ("] (2) De 10 a 1   ] ")
    EscrevaL ("] (2) Sair        ]")
    EscrevaL ("----------------- ")
    
    
    Escreva ("Digite a opção: ")
    Leia (n)
    
    Se (n = 1) entao
      Repita
        Escreval (c)
         c <- c + 1
      Ate (c = 10)
    FimSe
    
    
    Se (n = 2) entao
      Repita
      //c <- 10
        Escreval (c)
        c <- c - 1
      Ate (c < 1)
    FimSe
    
    
    
    REPITA
      Escreval(c)
      Se (n % c = 0) entao
        contDiv <- contDiv + 1
      FimSe
      c <- c + 1
    ATE (c > n)
    


fimalgoritmo


