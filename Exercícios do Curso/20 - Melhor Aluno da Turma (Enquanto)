//Melhor Aluno da turma

Algoritmo "Exercicio02"

Var

   cont, quant, nota, notaMaior: inteiro
   nome, melhorAluno: caractere

Inicio

   cont <- 1

   Escreval ("-----------------------------------------")
   Escreval (" MELHR ALUNON DA TURMA")
   Escreval ("-----------------------------------------")
   
   Escreval (" ")
   
   Escreval ("Digite a quantidade de alunos da turma: ")
   Leia (quant)
   Escreval (" ")
   Enquanto (cont <= quant) faca
   
   Escreval ("Digite o nome do aluno: ")
   Leia (nome)

   Escreval ("Digite a nota do aluno: ")
   Leia (nota)

   Escreval (" ")

   Se (nota > NotaMaior) entao
       notaMaior <- nota
       melhorAluno <- nome

   FimSe

    cont <- cont + 1

FimEnquanto

   Escreval ("---------------------------------------------------------------------------------")
   Escreval ("O aluno que teve o melhor aproveitamento foi ", melhorAluno, " com nota" , notaMaior)
   Escreval ("---------------------------------------------------------------------------------")

FimAlgoritmo
