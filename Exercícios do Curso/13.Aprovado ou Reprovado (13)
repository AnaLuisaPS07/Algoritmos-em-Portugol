algoritmo "AprovadoOUreprovado"

var
   n1,n2, m: real
   
inicio

      Escreva ("Digite a nota 1 do aluno: ")
      Leia (n1)
      Escreva ("Digite a nota 2 do aluno: ")
      Leia (n2)
      
      m <- (n1+n2)/2
      Escreval ("A media é ", m)

      Se (m >= 7) entao
         Escreva ("APROVADO!")
      Senao
        Escreva ("Reprovado!")
      FimSe

fimalgoritmo
