// Prática estruturas de repetição 01: enquanto

algoritmo "ContarATE10"

var

   contador: inteiro


inicio

      contador <- 0
      
      Enquanto (contador < 10) faca
      
        contador <- contador + 1
        Escreval (contador)
        
      FimEnquanto
      
      EScreval ("Terminei de contar")

fimalgoritmo
