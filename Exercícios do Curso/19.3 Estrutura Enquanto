// Prática estruturas de repetição 03: enquanto
//usuario entrando com valores e salto
//Contando de forma decrescente

algoritmo "ContarAteOndeQuiser"

var

   contador, valor, salto: inteiro


inicio

      contador <- 0
      
      Escreval ("Digite Até qual número deseja contar?")
      Leia (valor)

      Escreval ("Digite o tamanho do salto?")
      Leia (salto)

      Enquanto (contador <= valor) faca

        contador <- contador + salto
        Escreval (contador)

      FimEnquanto

      EScreval ("Terminei de contar")

fimalgoritmo
