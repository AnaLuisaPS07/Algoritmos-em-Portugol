algoritmo "creuza01"

var
   born, now, age :inteiro

inicio
        Escreval ("Digite o ano de nascimento: ")
        Leia (born)

        Escreval ("Digite o ano atual: ")
        Leia (now)

        age<- now-born

        Escreval ( age, " será a idade completada em ",now)

fimalgoritmo
