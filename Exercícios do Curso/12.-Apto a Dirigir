algoritmo "idade_dirigir"

var

   now, nasc, idade: inteiro
    
inicio
      Escreval ("--------------------------------------")
      Escreval ("VERIFICAÇÃO DE IDADE PARA DIRIGIR")
      Escreval ("--------------------------------------")
      Escreva ("Digite o ano atual: ")
      Leia (now)
      Escreva ("Digite o ano de nascimento: ")
      Leia (nasc)

      idade<- (now-nasc)

      Escreval ("--------------------------------------")
      Escreval ("A idade é ", idade, " anos")
      
      Se (Idade >=18) entao
          Escreval ("Está apto a dirigir")
          Escreva ("--------------------------------------")
      Senao
          Escreval ("--------------------------------------")
          Escreval ("Está inapto para dirigir")
          Escreval ("--------------------------------------")
      FimSe
      
fimalgoritmo
