//Exercício 8 - consumo
Algoritmo "consumo"

Var
    distancia, combustivel, consumo_medio: real

Inicio
   Escreva("Distancia percorrida: ")
   Leia(distancia)
    Escreva("Combustivel gasto: ")
    Leia(combustivel)
    consumo_medio <- distancia / combustivel
    Escreva("Consumo medio = ", consumo_medio:2:3)

Fimalgoritmo
