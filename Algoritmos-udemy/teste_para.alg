//testando estrutura para
Algoritmo "teste_para"

Var
   n, x, soma: inteiro

Inicio
   Escreva("Quantos números serão digitados? ")
   Leia(n)
   soma<-0

   para i de 1 ate n faca
     Escreva("Digite um numero: ")
     Leia(x)
     soma<- soma + x
   fimpara

   Escreva("SOMA = ", soma)
 

Fimalgoritmo