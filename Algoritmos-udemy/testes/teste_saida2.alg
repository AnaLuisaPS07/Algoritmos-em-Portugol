//exemplo prático
//várias expressões de uma vez

Algoritmo "teste_saida2"

Var

   idade: inteiro
   salario: real
   nome: caractere

Inicio
   idade <- 32
   salario <- 1400.99
   nome <- "Maria Silva"

   Escreval("A funcionária ",nome," ganha",salario:8:2," reais e tem", idade," anos" )


Fimalgoritmo
